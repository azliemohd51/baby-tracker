# Reference only — none of these belong in this repo or in index.html.
# They live inside your Pabbly Connect workflow as connection credentials / step config.

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Allowlisted Telegram chat IDs (comma-separated)
ALLOWED_CHAT_IDS=

# Anthropic API key (for the Claude parser step in Pabbly)
ANTHROPIC_API_KEY=

# 5 published-CSV URLs from Google Sheets — these DO go into index.html's CLOUD constant
GSHEET_FEEDS_CSV=
GSHEET_SLEEPS_CSV=
GSHEET_DIAPERS_CSV=
GSHEET_POOS_CSV=
GSHEET_PUMPS_CSV=
